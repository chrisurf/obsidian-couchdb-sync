{
	"name": "obsidian-couchdb-sync",
	"version": "0.40.0",
	"description": "Simple, reliable, end-to-end encrypted live sync for Obsidian against a self-hosted CouchDB.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src/",
		"lint:css": "stylelint styles.css --max-warnings 0",
		"lint:all": "npm run lint && npm run lint:css",
		"check:bundle": "node scripts/check-bundle-mobile-safe.mjs",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts",
		"test:e2e:only": "wdio run ./wdio.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"couchdb",
		"sync",
		"pouchdb"
	],
	"comment:browserslist": "Obsidian runs on a bundled Chromium (Electron on desktop, a modern WebView on mobile). Pin the CSS review (stylelint-no-unsupported-browser-features) to that Chromium floor so it reports exactly what the Obsidian community CSS scanner does.",
	"browserslist": [
		"chrome >= 114"
	],
	"author": "chrisurf",
	"license": "MIT",
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.11.0",
		"@types/pouchdb-browser": "^6.1.5",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"@vitest/coverage-v8": "^4.1.9",
		"@wdio/cli": "^9.28.0",
		"@wdio/globals": "^9.28.0",
		"@wdio/local-runner": "^9.28.0",
		"@wdio/mocha-framework": "^9.28.0",
		"@wdio/spec-reporter": "^9.28.0",
		"esbuild": "^0.20.0",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"events": "^3.3.0",
		"happy-dom": "^20.10.6",
		"mocha": "^10.8.2",
		"obsidian": "latest",
		"obsidian-launcher": "^3.1.1",
		"pouchdb-adapter-memory": "^9.0.0",
		"stylelint": "^16.26.1",
		"stylelint-no-unsupported-browser-features": "^8.1.1",
		"tsx": "^4.22.4",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.9",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	},
	"dependencies": {
		"pouchdb-browser": "^9.0.0"
	},
	"overrides": {
		"uuid": "^11.1.1"
	}
}
